# Non-secret defaults, committed. Override anything here in .env.local.
# Gemini free tier is 5 req/min + 20 req/day PER MODEL, so rotate across several.
STORY_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
# Single-model override; "mock" serves canned pages with no API calls.
# STORY_MODEL=mock
STORY_API_KEY_NAME=GOOGLE_GENERATIVE_AI_API_KEY
